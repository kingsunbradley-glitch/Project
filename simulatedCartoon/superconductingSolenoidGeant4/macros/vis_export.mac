/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/sim/geometry/solenoidRadius 0.20 m
/sim/geometry/solenoidLength 1.00 m
/sim/geometry/targetDistance 0.30 m
/sim/field/centerField 2.50 tesla
/sim/gas/enabled true
/sim/gas/pressure 100 pascal
/sim/gas/temperature 300 kelvin
/sim/reaction/projectileZA 18 40
/sim/reaction/targetZA 69 169
/sim/reaction/beamEnergyLab 200 MeV
/sim/reaction/mode reaction
/sim/output/fileName output/vis_export.root
/sim/output/trackSampleCount 20
/sim/output/randomSeed 20260810
/run/initialize
/vis/open OGLSQt 1100x760-0+0
/vis/drawVolume
/vis/scene/add/axes 0 0 0 0.25 m
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts true
/vis/modeling/trajectories/drawByCharge-0/default/setStepPtsSize 2
/vis/scene/add/trajectories smooth
/vis/scene/endOfEventAction accumulate 20
/vis/viewer/set/viewpointThetaPhi 65 25 deg
/vis/viewer/set/style surface
/vis/viewer/set/auxiliaryEdge true
/tracking/storeTrajectory 1
/run/beamOn 20
/vis/viewer/flush
/vis/ogl/set/exportFormat pdf
/vis/ogl/set/printFilename output/open_gl_tracks
/vis/ogl/export
